da\",\n            color: pass ? \"#155724\" : \"#721c24\",\n            fontWeight: 500,\n            marginBottom: 16\n          }}\u003e\n            {pass ? \"PASS\" : \"FAIL\"} — Disparate Impact Ratio: {auditData.disparate_impact_ratio?.toFixed(3)}\n            {!pass \u0026\u0026 \" (below 4/5ths rule threshold of 0.8)\"}\n          \u003c/div\u003e\n\n          \u003cResponsiveContainer width=\"100%\" height={240}\u003e\n            \u003cBarChart data={[\n  { group: \"White\", rate: auditData?.white_approval_rate || 0 },\n  { group: \"Black\", rate: auditData?.black_approval_rate || 0 },\n  { group: \"Hispanic\", rate: auditData?.hispanic_approval_rate || 0 },\n]}\u003e"},{"isSelected":true},{"content":"\n              \u003cXAxis dataKey=\"group\" /\u003e\n              \u003cYAxis domain={[0, 1]} tickFormatter={v =\u003e `${(v*100).toFixed(0)}%`} /\u003e\n              \u003cTooltip formatter={v =\u003e `${(v*100).toFixed(1)}%`} /\u003e\n              \u003cReferenceLine y={0.8} stroke=\"#dc3545\" strokeDasharray=\"4 4\" label=\"4/5ths rule\" /\u003e\n              \u003cBar dataKey=\"rate\" fill=\"#4285F4\" /\u003e\n            \u003c/BarChart\u003e\n          \u003c/ResponsiveContainer\u003e\n        \u003c/\u003e\n      )}\n\n      {loading \u0026\u0026 \u003cp style={{ color: \"#888\", fontSize: 13 }}\u003eRecalculating...\u003c/p\u003e}\n    \u003c/div\u003e\n  );\n}"}]}},"metadata":{"duetProject":"cloudshell-gca","ideName":"Code OSS for Cloud Shell","ideType":"CLOUD_SHELL","ideVersion":"1.109.5-cde","platform":"LINUX_AMD64","pluginType":"CLOUD_CODE","pluginVersion":"2.77.3"},"project":"cloudshell-gca","requestId":"cloudcode-897277222-6fe1442b-c4ba-46a1-b834-f3d8936d3075","userContext":{}}
